# 仅用于 Docker Compose；修改配置后重新执行 docker compose up -d
# 主机访问端口；未设置或留空时默认 8080，容器内部端口保持 8080
KANBAN_PORT=8080

# 管理员初始化配置：只在首次初始化空数据库时生效
KANBAN_ADMIN_USER=admin
# 请填入随机生成的密码，至少 12 字节，最多 72 字节；不要提交 .env
KANBAN_ADMIN_PASS=

# HTTPS 反向代理部署时设 true；本机 HTTP 调试保持 false
KANBAN_COOKIE_SECURE=false

# Docker 构建时的 Go 模块代理；国内服务器可改为 https://goproxy.cn,direct
# 修改后需执行 docker compose up -d --build --wait
KANBAN_GOPROXY=https://proxy.golang.org,direct
